# Binarios grandes y descargables — se regeneran con los scripts de macos/
macos/tools/
macos/recovery/
macos/recovery_ventura/
macos/kexts/
macos/kexts_update/

# EFI de referencia (HP 245 G8 Ryzen 5 5500U): versionar solo lo útil para
# comparar (config.plist, README, ACPI/*.aml, Info.plist de kexts). El resto
# son binarios pesados (~29 MB) que no aportan al diagnóstico.
macos/docs/hp-245-g8-efi-base/Resources/
macos/docs/hp-245-g8-efi-base/Drivers/
macos/docs/hp-245-g8-efi-base/Tools/
macos/docs/hp-245-g8-efi-base/OpenCore.efi
macos/docs/hp-245-g8-efi-base/**/MacOS/
macos/docs/hp-245-g8-efi-base/**/_CodeSignature/

# Herramientas externas clonadas (tienen su propio .git, ~13 MB). Se usan como
# referencia local; el perfil de hardware se conserva en macos/docs/Report.json.
macos/docs/OpCore-Simplify/
macos/docs/Hardware-Sniffer/
macos/acpi_dump/

# Logs de los scripts
macos/*.log

# Configs viejos de OCAT (el config real vive en macos/EFI/OC/config.plist)
macos/config.plist
macos/oldConfig.plist

# Backups automáticos del generador de config
macos/EFI/OC/config_backup_*.plist

# Fotos de diagnóstico del arranque (también en la raíz del repo)
*.jpeg
*.jpg

# Caché de Python
__pycache__/
*.pyc

# Runtime / caché de claude-flow
.claude-flow/

# ── Tooling de ruflo / claude-flow (NO es parte del proyecto Hackintosh) ──
# Dependencias y manifiestos de Node (los trae la instalación de ruflo)
node_modules/
package.json
package-lock.json
pnpm-lock.yaml
pnpm-workspace.yaml
.mcp.json

# Bases de datos y estado de runtime de ruflo
*.db
ruvector.db
.swarm/

# Runtime/caché generado dentro de .claude por ruflo (solo cachés y generados)
.claude/memory.db
.claude/*.db
.claude/statusline.*
.claude/agents/testing/unit/
.claude/agents/testing/validation/

# Sesiones y artefactos de herramientas AI (Grok, Claude, etc.)
.grok/
.comments/
Pasted image*.png
IMG_*.JPEG
IMG_*.JPG
IMG_*.PNG
IMG_*.MOV
IMG_*.MP4

# ── Referencias EFI clonadas (mantener solo lo útil para comparar) ──
# Otus9051 (HP 15s con Ryzen 3 5300U exacto) — igual que hp-245-g8-efi-base
macos/docs/otus9051-hp15s/Resources/
macos/docs/otus9051-hp15s/Drivers/
macos/docs/otus9051-hp15s/Tools/
macos/docs/otus9051-hp15s/OpenCore.efi
macos/docs/otus9051-hp15s/Kexts/
macos/docs/otus9051-hp15s/**/MacOS/
macos/docs/otus9051-hp15s/**/_CodeSignature/

# ACPI compilados cuando existe fuente .dsl (en acpi_src/)
macos/acpi_src/*.aml

# DSDT extraídos (se regeneran)
macos/docs/DSDT.aml
macos/docs/DSDT.dsl
